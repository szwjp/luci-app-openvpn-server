#!/bin/sh /etc/rc.common
# luci-app-openvpn-server 专属 init 脚本。
# 读取 /etc/config/openvpn-server（由 'openvpn' 改名而来，避免与
# openvpn-openssl 包共有的 /etc/config/openvpn 发生文件归属冲突）。
# 自包含实现，不依赖 openvpn 包的 helper 文件，跨版本更稳。

START=90
STOP=10
USE_PROCD=1
PROG=/usr/sbin/openvpn

CONF_DIR=/var/etc
CONF=

# 输出 "opt value"，选项名下划线转横线，空值跳过
emit() {
	local opt="$2" val="$3"
	[ -n "$val" ] || return 0
	opt=$(echo "$opt" | tr '_' '-')
	echo "$opt $val" >> "$CONF"
}

# 布尔选项：值为 1 时仅输出选项名
emit_bool() {
	local opt="$2" val="$3"
	[ "$val" = "1" ] || return 0
	opt=$(echo "$opt" | tr '_' '-')
	echo "$opt" >> "$CONF"
}

push_line() {
	echo "push \"$1\"" >> "$CONF"
}

server_instance() {
	local s="$1"
	local enabled proto port dev topology server comp_lzo
	local ca dh cert key persist_key persist_tun user group
	local max_clients keepalive verb status log
	local duplicate_cn client_to_client redirect_gateway

	config_get_bool enabled "$s" enabled 0
	[ "$enabled" -gt 0 ] || return 1

	config_get proto "$s" proto
	config_get port "$s" port
	config_get dev "$s" dev
	config_get topology "$s" topology
	config_get server "$s" server
	config_get comp_lzo "$s" comp_lzo
	config_get ca "$s" ca
	config_get dh "$s" dh
	config_get cert "$s" cert
	config_get key "$s" key
	config_get persist_key "$s" persist_key
	config_get persist_tun "$s" persist_tun
	config_get user "$s" user
	config_get group "$s" group
	config_get max_clients "$s" max_clients
	config_get keepalive "$s" keepalive
	config_get verb "$s" verb
	config_get status "$s" status
	config_get log "$s" log
	config_get duplicate_cn "$s" duplicate_cn
	config_get client_to_client "$s" client_to_client
	config_get redirect_gateway "$s" redirect_gateway

	mkdir -p "$CONF_DIR"
	CONF="$CONF_DIR/openvpn-server-$s.conf"
	: > "$CONF"

	emit "$CONF" proto "$proto"
	emit "$CONF" port "$port"
	emit "$CONF" dev "$dev"
	emit "$CONF" topology "$topology"
	emit "$CONF" server "$server"
	emit "$CONF" comp_lzo "$comp_lzo"
	emit "$CONF" ca "$ca"
	emit "$CONF" dh "$dh"
	emit "$CONF" cert "$cert"
	emit "$CONF" key "$key"
	emit_bool "$CONF" persist_key "$persist_key"
	emit_bool "$CONF" persist_tun "$persist_tun"
	emit "$CONF" user "$user"
	emit "$CONF" group "$group"
	emit "$CONF" max_clients "$max_clients"
	emit "$CONF" keepalive "$keepalive"
	emit "$CONF" verb "$verb"
	emit "$CONF" status "$status"
	emit "$CONF" log "$log"
	emit_bool "$CONF" duplicate_cn "$duplicate_cn"
	emit_bool "$CONF" client_to_client "$client_to_client"
	emit "$CONF" redirect_gateway "$redirect_gateway"
	config_list_foreach "$s" push push_line

	procd_open_instance "openvpn-server-$s"
	procd_set_param command "$PROG" --syslog "openvpn-server($s)" --config "$CONF"
	procd_set_param file "$CONF"
	procd_set_param respawn 3600 5 -1
	procd_close_instance
}

start_service() {
	config_load openvpn-server
	config_foreach server_instance openvpn
}

service_triggers() {
	procd_add_reload_trigger openvpn-server
}
